{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rnd-pro.github.io/symbiote-ui/schemas/xr-portable-panel-state-v1.json",
  "title": "XR Portable Panel State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "layoutRevision",
    "focusedPanelId",
    "panels"
  ],
  "properties": {
    "version": { "const": "xr-portable-panel-state-v1" },
    "layoutRevision": { "type": "integer", "minimum": 0 },
    "focusedPanelId": { "type": ["string", "null"] },
    "panels": {
      "type": "array",
      "items": { "$ref": "#/$defs/panel" }
    }
  },
  "$defs": {
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "quaternion": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "number" }
    },
    "size2d": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number", "exclusiveMinimum": 0 }
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "canonical",
        "current",
        "portable",
        "pinned",
        "focused",
        "revision",
        "sourceMetadata"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "canonical": {
          "type": "object",
          "additionalProperties": false,
          "required": ["position", "quaternion", "size"],
          "properties": {
            "position": { "$ref": "#/$defs/vector3" },
            "quaternion": { "$ref": "#/$defs/quaternion" },
            "size": { "$ref": "#/$defs/size2d" }
          }
        },
        "current": {
          "type": "object",
          "additionalProperties": false,
          "required": ["position", "quaternion", "size"],
          "properties": {
            "position": { "$ref": "#/$defs/vector3" },
            "quaternion": { "$ref": "#/$defs/quaternion" },
            "size": { "$ref": "#/$defs/size2d" }
          }
        },
        "portable": { "type": "boolean" },
        "pinned": { "type": "boolean" },
        "focused": { "type": "boolean" },
        "hidden": { "type": "boolean" },
        "revision": { "type": "integer", "minimum": 0 },
        "sourceMetadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
