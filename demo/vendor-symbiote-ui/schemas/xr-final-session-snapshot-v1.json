{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rnd-pro.github.io/symbiote-ui/schemas/xr-final-session-snapshot-v1.json",
  "title": "XR Final Session Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "panelState",
    "receipts",
    "frameTiming",
    "facts"
  ],
  "properties": {
    "version": {
      "const": "xr-final-session-snapshot-v1"
    },
    "panelState": {
      "$ref": "https://rnd-pro.github.io/symbiote-ui/schemas/xr-portable-panel-state-v1.json"
    },
    "receipts": {
      "type": "array",
      "items": {
        "$ref": "https://rnd-pro.github.io/symbiote-ui/schemas/xr-portable-panel-receipt-v1.json"
      }
    },
    "frameTiming": {
      "$ref": "https://rnd-pro.github.io/symbiote-ui/schemas/xr-frame-timing-v1.json"
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endEventObserved",
        "providerIdle",
        "activeSessionCleared",
        "rootHidden",
        "controllersDestroyed",
        "captureStopped",
        "teardownReason"
      ],
      "properties": {
        "endEventObserved": {
          "type": "boolean"
        },
        "providerIdle": {
          "type": "boolean"
        },
        "activeSessionCleared": {
          "type": "boolean"
        },
        "rootHidden": {
          "type": "boolean"
        },
        "controllersDestroyed": {
          "type": "boolean"
        },
        "captureStopped": {
          "type": "boolean"
        },
        "teardownReason": {
          "enum": [
            "stop-called",
            "end-event",
            "start-failed"
          ]
        }
      }
    }
  }
}