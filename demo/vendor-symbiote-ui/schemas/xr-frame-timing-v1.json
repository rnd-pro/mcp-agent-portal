{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rnd-pro.github.io/symbiote-ui/schemas/xr-frame-timing-v1.json",
  "title": "XR Frame Timing",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "nominalFrameRate",
    "effectiveFrameRate",
    "durationMs",
    "sampleCount",
    "meanIntervalMs",
    "p95IntervalMs",
    "maxIntervalMs",
    "dropRatio",
    "supportedFrameRates",
    "resetCount",
    "resets"
  ],
  "properties": {
    "version": { "const": "xr-frame-timing-v1" },
    "nominalFrameRate": { "type": ["number", "null"] },
    "effectiveFrameRate": { "type": "number" },
    "durationMs": { "type": "number" },
    "sampleCount": { "type": "integer" },
    "meanIntervalMs": { "type": "number" },
    "p95IntervalMs": { "type": "number" },
    "maxIntervalMs": { "type": "number" },
    "dropRatio": { "type": "number" },
    "supportedFrameRates": {
      "type": ["array", "null"],
      "items": { "type": "number" }
    },
    "resetCount": { "type": "integer", "minimum": 0 },
    "resets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "reason", "previousTimestamp", "timestamp"],
        "properties": {
          "sequence": { "type": "integer", "minimum": 1 },
          "reason": { "enum": ["init", "discontinuity", "hidden", "non-monotonic"] },
          "previousTimestamp": { "type": ["number", "null"] },
          "timestamp": { "type": "number" }
        }
      }
    }
  }
}
