{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rnd-pro.github.io/symbiote-ui/schemas/xr-portable-panel-receipt-v1.json",
  "title": "XR Portable Panel Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "receiptId",
    "sequence",
    "action",
    "phase",
    "panelId",
    "accepted",
    "reason",
    "sessionId",
    "startFrameId",
    "endFrameId",
    "timestamp",
    "inputSourceId",
    "inputKind",
    "handedness",
    "profiles",
    "layoutRevisionBefore",
    "layoutRevisionAfter",
    "before",
    "after"
  ],
  "properties": {
    "version": { "const": "xr-portable-panel-receipt-v1" },
    "receiptId": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "action": { "enum": ["focus", "pin", "reset", "move", "resize", "close", "restore"] },
    "phase": { "enum": ["applied", "settled", "rejected"] },
    "panelId": { "type": "string", "minLength": 1 },
    "accepted": { "type": "boolean" },
    "reason": { "type": ["string", "null"] },
    "sessionId": { "type": "string", "minLength": 1 },
    "startFrameId": { "type": "string", "minLength": 1 },
    "endFrameId": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "number" },
    "inputSourceId": { "type": "string", "minLength": 1 },
    "inputKind": { "enum": ["controller", "hand"] },
    "handedness": { "enum": ["left", "right", "none"] },
    "profiles": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "layoutRevisionBefore": { "type": "integer", "minimum": 0 },
    "layoutRevisionAfter": { "type": "integer", "minimum": 0 },
    "before": { "$ref": "#/$defs/panel" },
    "after": { "$ref": "#/$defs/panel" }
  },
  "$defs": {
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "quaternion": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "number" }
    },
    "size2d": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number", "exclusiveMinimum": 0 }
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "canonical",
        "current",
        "portable",
        "pinned",
        "focused",
        "revision",
        "sourceMetadata"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "canonical": {
          "type": "object",
          "additionalProperties": false,
          "required": ["position", "quaternion", "size"],
          "properties": {
            "position": { "$ref": "#/$defs/vector3" },
            "quaternion": { "$ref": "#/$defs/quaternion" },
            "size": { "$ref": "#/$defs/size2d" }
          }
        },
        "current": {
          "type": "object",
          "additionalProperties": false,
          "required": ["position", "quaternion", "size"],
          "properties": {
            "position": { "$ref": "#/$defs/vector3" },
            "quaternion": { "$ref": "#/$defs/quaternion" },
            "size": { "$ref": "#/$defs/size2d" }
          }
        },
        "portable": { "type": "boolean" },
        "pinned": { "type": "boolean" },
        "focused": { "type": "boolean" },
        "hidden": { "type": "boolean" },
        "revision": { "type": "integer", "minimum": 0 },
        "sourceMetadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
