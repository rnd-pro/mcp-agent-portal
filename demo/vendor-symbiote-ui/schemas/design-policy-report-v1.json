{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rnd-pro.github.io/symbiote-ui/schemas/design-policy-report-v1.json",
  "title": "Symbiote Design Policy Validation Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "status", "constraints", "violations", "suggestedPatches"],
  "properties": {
    "version": { "const": "design-policy-v1" },
    "kind": { "enum": ["theme", "design"] },
    "status": { "enum": ["pass", "warn", "blocked"] },
    "constraints": {
      "type": "object",
      "additionalProperties": true,
      "required": ["version", "status", "ruleStack", "parameters"],
      "properties": {
        "version": { "const": "design-policy-v1" },
        "status": { "enum": ["pass", "blocked"] },
        "ruleStack": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["layer", "priority", "rules"],
            "properties": {
              "layer": {
                "enum": [
                  "accessibility",
                  "host-policy",
                  "register",
                  "component-family",
                  "recipe",
                  "brand-context",
                  "user-tweak"
                ]
              },
              "priority": { "type": "number" },
              "rules": {
                "type": "array",
                "items": { "$ref": "#/$defs/rule" }
              }
            }
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": true,
            "required": ["baseRange", "derivedRange", "status", "hardRules", "softRanges", "conflicts"],
            "properties": {
              "baseRange": { "$ref": "#/$defs/range" },
              "derivedRange": { "$ref": "#/$defs/range" },
              "status": { "enum": ["pass", "blocked"] },
              "hardRules": {
                "type": "array",
                "items": { "$ref": "#/$defs/rule" }
              },
              "softRanges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "required": ["ruleId", "layer", "severity", "range", "reason"],
                  "properties": {
                    "ruleId": { "type": "string", "minLength": 1 },
                    "layer": { "type": "string", "minLength": 1 },
                    "severity": { "enum": ["hard", "soft"] },
                    "range": { "$ref": "#/$defs/range" },
                    "reason": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "conflicts": {
                "type": "array",
                "items": { "$ref": "#/$defs/violation" }
              }
            }
          }
        },
        "conflicts": {
          "type": "array",
          "items": { "$ref": "#/$defs/violation" }
        },
        "activeContext": { "type": "object", "additionalProperties": true }
      }
    },
    "violations": {
      "type": "array",
      "items": { "$ref": "#/$defs/violation" }
    },
    "suggestedPatches": {
      "type": "array",
      "items": { "$ref": "#/$defs/patch" }
    }
  },
  "$defs": {
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "layer", "priority", "severity", "reason"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "layer": { "type": "string", "minLength": 1 },
        "priority": { "type": "number" },
        "severity": { "enum": ["hard", "soft"] },
        "parameter": { "type": "string" },
        "range": { "$ref": "#/$defs/range" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "violation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "severity", "reason"],
      "properties": {
        "status": { "enum": ["blocked", "warn", "pass"] },
        "severity": { "enum": ["hard", "soft"] },
        "parameter": { "type": "string" },
        "path": { "type": "string" },
        "value": {},
        "derivedRange": { "$ref": "#/$defs/range" },
        "reason": { "type": "string", "minLength": 1 },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/rule" }
        }
      }
    },
    "patch": {
      "type": "object",
      "additionalProperties": true,
      "required": ["op", "path", "reason"],
      "properties": {
        "op": { "enum": ["add", "replace", "remove"] },
        "path": { "type": "string", "minLength": 1 },
        "value": {},
        "reason": { "type": "string", "minLength": 1 },
        "ruleId": { "type": "string" }
      }
    }
  }
}
