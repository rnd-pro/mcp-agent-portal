{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "background": { "$type": "color", "$value": "var(--sn-sys-surface)" },
    "surface": { "$type": "color", "$value": "var(--sn-sys-surface-raised)" },
    "border": { "$type": "color", "$value": "var(--sn-sys-outline)" },
    "text": { "$type": "color", "$value": "var(--sn-sys-on-surface)" },
    "textDim": { "$type": "color", "$value": "var(--sn-sys-on-surface-dim)" },
    "accent": { "$type": "color", "$value": "var(--sn-sys-accent)" },
    "success": { "$type": "color", "$value": "var(--sn-sys-success)" },
    "warning": { "$type": "color", "$value": "var(--sn-sys-warning)" },
    "danger": { "$type": "color", "$value": "var(--sn-sys-danger)" }
  },
  "size": {
    "grid": { "$type": "dimension", "$value": "var(--sn-grid-size)" },
    "socket": { "$type": "dimension", "$value": "var(--sn-socket-size)" },
    "socketBorder": { "$type": "dimension", "$value": "var(--sn-socket-border-width)" }
  },
  "radius": {
    "node": { "$type": "dimension", "$value": "var(--sn-node-radius)" },
    "comment": { "$type": "dimension", "$value": "var(--sn-comment-radius)" }
  },
  "shadow": {
    "node": { "$type": "shadow", "$value": "var(--sn-node-shadow)" }
  },
  "font": {
    "family": { "$type": "fontFamily", "$value": "var(--sn-font)" }
  }
}
