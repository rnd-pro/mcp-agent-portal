    "./xr/three-native-panel-renderer": "./xr/three-native-panel-renderer.js",
    "./xr/spatial-snapshot": "./xr/spatial-snapshot.js",
    "./xr/spatial-snapshot-compile": "./xr/spatial-snapshot-compile.js",
    "./xr/spatial-parity": "./xr/spatial-parity.js",
    "./xr/spatial-visual-parity": "./xr/spatial-visual-parity.js",
    "./xr/dom-spatial-capture": "./xr/dom-spatial-capture.js",
