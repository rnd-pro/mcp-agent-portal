      "import": "./layout/index.js",
      "default": "./layout/index.js"
    },
    "./layout/LayoutTree": "./layout/LayoutTree.js",
    "./layout/panel-layout": {
      "import": "./layout/Layout/Layout.js",
      "default": "./layout/Layout/Layout.js"
    },
    "./runtime": {
      "import": "./runtime/index.js",
      "default": "./runtime/index.js"
    },
    "./runtime/product-context": "./runtime/product-context.js",
    "./xr": {
      "import": "./xr/index.js",
      "default": "./xr/index.js"
    },
    "./xr/spatial-index": "./xr/spatial-index.js",
    "./xr/spatial-graph": "./xr/spatial-graph.js",
    "./xr/spherical-layout": "./xr/spherical-layout.js",
