    "./custom-elements.json": "./custom-elements.json",
    "./tree/TreeView": "./tree/TreeView/TreeView.js",
    "./tree/TreePanel": "./tree/TreePanel/TreePanel.js",
    "./display/code-block": "./display/CodeBlock/CodeBlock.js",
    "./display/source-viewer": "./display/SourceViewer/SourceViewer.js",
