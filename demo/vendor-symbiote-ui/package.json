    "./ui/screencast-recorder.js": "./ui/screencast-recorder.js",
    "./ui/tour-screencast.js": "./ui/tour-screencast.js",
    "./ui/tour-audio-provider.js": "./ui/tour-audio-provider.js",
    "./ui/tour-media-renderer.js": "./ui/tour-media-renderer.js",
    "./ui/live-captions.js": "./ui/live-captions.js",
    "./ui/scrollbar-styles.js": "./ui/scrollbar-styles.js",
    "./webmcp": {
      "import": "./webmcp.js",
      "default": "./webmcp.js"
    },
    "./discover": {
      "import": "./discover.js",
      "default": "./discover.js"
    },
    "./motion": {
      "import": "./themes/Motion.js",
      "default": "./themes/Motion.js"
    },
    "./notifications": {
      "import": "./notifications/notification-queue.js",
      "default": "./notifications/notification-queue.js"
    },
    "./themes/TailwindBridge": {
      "import": "./themes/TailwindBridge.js",
      "default": "./themes/TailwindBridge.js"
    }
  },
  "files": [
    "index.js",
    "custom-elements.json",
    "core/",
    "contracts/",
    "graph/",
    "icons/",
    "discover.js",
    "audit.js",
    "cli.js",
    "webmcp.js",
    "manifest/",
    "tokens/",
    "rules/",
    "schemas/",
    "shapes/",
    "themes/",
    "plugins/",
    "canvas/",
    "board/",
    "node/",
    "interactions/",
    "layout/",
    "runtime/",
    "locale/",
    "xr/",
    "navigation/",
    "notifications/",
    "display/",
    "effects/",
    "control/",
    "surface/",
    "chat/",
    "notifications/",
    "list/",
    "tree/",
    "timeline/",
    "toolbar/",
    "inspector/",
    "palette/",
    "menu/",
    "marketplace/",
    "ui/",
    "docs/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "llms.txt",
    "skills/"
  ],
  "sideEffects": [
    "**/*.css.js",
    "**/*.tpl.js",
    "core/base-path.js",
    "themes/CascadeThemeEditor/CascadeThemeEditor.js",
    "themes/CascadeThemeWidget/CascadeThemeWidget.js",
    "themes/CascadeThemeImportDialog/CascadeThemeImportDialog.js",
    "ui/index.js",
    "ui/media/**/*.js",
    "canvas/**/*.js",
    "board/**/*.js",
    "node/**/*.js",
    "layout/**/*.js",
    "xr/**/*.js",
    "display/**/*.js",
    "effects/**/*.js",
    "control/**/*.js",
    "surface/**/*.js",
    "chat/**/*.js",
    "list/**/*.js",
    "tree/**/*.js",
    "timeline/**/*.js",
    "navigation/**/*.js",
    "toolbar/**/*.js",
    "inspector/**/*.js",
    "palette/**/*.js",
    "menu/**/*.js",
    "marketplace/**/*.js"
  ],
  "bin": {
    "symbiote-ui": "cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node tests/run-tests.js -- node --test tests/*.test.js",
    "test:browser": "node tests/run-tests.js --suite browser -- node --test tests/graph-browser-smoke.test.js",
    "catalog:build": "rm -rf _site && jsda build",
    "catalog:dev": "jsda ssg",
    "catalog:serve": "npx -y serve _site -l 3001",
    "catalog:site": "npm run catalog:build && node scripts/assemble-site.js && node tests/validate-site.js",
    "libs:status": "node ../symbiote-dev-plane/bin/symbiote-libs.js status",
    "libs:link": "node ../symbiote-dev-plane/bin/symbiote-libs.js link",
    "libs:unlink": "node ../symbiote-dev-plane/bin/symbiote-libs.js unlink --install"
  },
  "keywords": [
    "node-editor",
    "graph-editor",
    "visual-programming",
    "node-graph",
    "symbiote",
    "web-components",
    "data-flow",
    "dag",
    "webmcp",
    "ssr"
  ],
  "dependencies": {
    "symbiote-engine": "0.3.0-alpha.13"
  },
  "peerDependencies": {
    "@symbiotejs/symbiote": "3.8.0-webmcp.2"
  },
  "devDependencies": {
    "@symbiotejs/symbiote": "3.8.0-webmcp.2",
    "ajv": "^8.20.0",
    "jsda-kit": "1.6.0",
    "library-pages": "0.1.0-alpha.13",
    "linkedom": "^0.18.12",
    "three": "0.185.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RND-PRO/symbiote-ui.git"
  },
  "homepage": "https://rnd-pro.github.io/symbiote-ui/",
  "bugs": {
    "url": "https://github.com/RND-PRO/symbiote-ui/issues"
  },
  "author": "RND-PRO <nicothin@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
