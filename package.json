{
  "name": "mcp-agent-portal",
  "version": "1.0.0-alpha.4",
  "description": "Unified Agent & MCP Control Plane — aggregator for AI agents and MCP tools",
  "type": "module",
  "main": "index.js",
  "bin": {
    "mcp-agent-portal": "bin/mcp-agent-portal.js"
  },
  "scripts": {
    "build": "node scripts/build-web.js",
    "start": "node bin/mcp-agent-portal.js",
    "dev": "node index.js --dev",
    "prepack": "npm run build",
    "xr:visual-smoke": "node scripts/diagnostics/xr-visual-agent-smoke.js",
    "xr:three-smoke": "node scripts/diagnostics/xr-three-baseline-smoke.js",
    "xr:production-smoke": "node scripts/diagnostics/xr-production-spatial-smoke.js",
    "xr:headset-summary": "node scripts/diagnostics/xr-headset-summary-smoke.js",
    "xr:headset-wait": "node scripts/diagnostics/xr-headset-summary-smoke.js --wait-ms 120000 --interval-ms 2000",
    "test:audit": "node scripts/test-hygiene-audit.js",
    "test:unit": "node --test --test-timeout 10000 test/unit/*.test.js",
    "test:integration": "node --test --test-timeout 20000 test/integration/*.test.js",
    "test": "npm run test:unit && npm run test:integration",
    "submodules": "git submodule update --init --recursive"
  },
  "keywords": [
    "mcp",
    "agent",
    "control-plane",
    "dashboard",
    "ai",
    "marketplace"
  ],
  "author": "RND-PRO",
  "license": "MIT",
  "dependencies": {
    "@iwer/devui": "^1.1.2",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@symbiotejs/symbiote": "3.8.0-webmcp.2",
    "iwer": "^2.2.1",
    "symbiote-engine": "0.3.0-alpha.4",
    "symbiote-node": "0.3.0-alpha.4",
    "symbiote-ui": "0.3.0-alpha.4",
    "telegraf": "^4.16.3",
    "three": "^0.184.0",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "globals": "^17.5.0"
  }
}
